{
    "[python]": {
        "editor.formatOnSave": true
    },
    "[cpp]": {
        "editor.formatOnSave": true,
        "editor.semanticHighlighting.enabled": true,
    },
    "[yaml]": {
        "editor.formatOnSave": false
    },
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.analysis.enablePytestSupport": true,
    "python.languageServer": "Default",
    "autopep8.args": [
        "--max-line-length=100",
        "--aggressive"
    ],
    "autopep8.importStrategy": "fromEnvironment",
    "autopep8.path": [
        "${workspaceFolder}/.venv/bin/autopep8"
    ],
    "pylint.importStrategy": "fromEnvironment",
    "python.analysis.extraPaths": [
        "${workspaceFolder}/pymodules",
    ],
    "pylint.interpreter": [
        "${workspaceFolder}/.venv/bin/python"
    ],
    "pylint.path": [
        "${workspaceFolder}/.venv/bin/pylint"
    ],
    "cmake.cmakePath": "${workspaceFolder}/.venv/bin/cmake",
    "clang-format.executable": "${workspaceFolder}/.venv/bin/clang-format",
    "clang-format.style": "file:${workspaceFolder}/setuputils/.clang-format",
    "mypy.dmypyExecutable": "${workspaceFolder}/.venv/bin/dmypy",
    "mypy.mypyExecutable": "${workspaceFolder}/.venv/bin/mypy",
    "mypy.targets": [
        "pymodules"
    ]
}